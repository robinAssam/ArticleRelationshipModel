# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- Distribution ---
build/
dist/
*.egg-info/

# --- Editors ---
.vscode/
.idea/
*.swp
.DS_Store
# Office lock files (created while a document is open)
~$*

# --- Project-specific ---
# never commit large model files or full case-law dumps
*.bin
*.safetensors
data/raw/case_law/*
!data/raw/case_law/.gitkeep

# but DO commit small annotated samples and the validation set
!data/validation/*.csv
!data/annotations/*.json

# notebook outputs (clear before commit, or use nbstripout)
# uncomment if you set up nbstripout:
# notebooks/*.ipynb

# Local secrets (API keys) for Streamlit
.streamlit/secrets.toml

# Obsidian settings created when the project folder is opened as a vault
/.obsidian/

# Generated by src/data/generate_obsidian.py; rebuild instead of committing
data/obsidian_vault/

# Personal files (thesis plan, notes, papers): separate private repo, see private/
/private/

# Study A items include judgment text; rebuild with scripts/build_study_a.py.
# The split and answers (split.csv) are committed.
data/processed/study_a/queries.jsonl

# Raw statute XML from the BWB (several MB; re-download with scripts/fetch_statutes.py)
data/raw/statutes/*.xml
