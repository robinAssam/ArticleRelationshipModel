    "   \"source\": [\n",
    "    \"### What changed?\\n\",\n",
    "    \"\\n\",\n",
    "    \"The same edges as before, but `weighted_strength` is now informative:\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"This ranking is what cluster-detection algorithms will use later: weighted edges produce more meaningful cluster boundaries than uniform edges.\\n\"\n",
    "   ]\n",
