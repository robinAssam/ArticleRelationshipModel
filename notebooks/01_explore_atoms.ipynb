    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 9. Semantic similarity (the new edge channel)\\n\",\n",
    "    \"\\n\",\n",
    "    \"Exact set intersection misses synonyms and related concepts: `dossier` won't\\n\",\n",
    "    \"match `gegevens`, `hulpverlener` won't match `zorgverlener`. The semantic\\n\",\n",
    "    \"layer fixes that with a multilingual sentence-transformer. !*We changed the model to an english model.\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {\n",
