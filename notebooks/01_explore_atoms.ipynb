    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 8. Tag weighting (discriminative weights)\\n\",\n",
    "    \"\\n\",\n",
    "    \"Common tags  don't really distinguish\\n\",\n",
    "    \"anything. IDF down-weights them and up-weights rare/discriminative tags.\\n\",\n",
    "    \"\\n\",\n",
    "    \"Two modes:\\n\",\n",
    "    \"- `'idf'` — rare tags get high weight (log inverse document frequency)\\n\",\n",
    "    \"- `'tf'` — common tags get high weight (raw frequency)\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-06-23T13:08:23.293559Z\",\n",
    "     \"start_time\": \"2026-06-23T13:08:23.280808Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# Compute IDF weights for every (field, tag) pair\\n\",\n",
    "    \"weights_idf = compute_tag_weights(df, method='idf')\\n\",\n",
    "    \"print(f'Computed {len(weights_idf)} tag weights')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# View all weights sorted high to low\\n\",\n",
    "    \"show_tag_weights(weights_idf)\\n\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"Computed 197 tag weights\\n\"\n",
    "     ]\n",
    "    },\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"        field                                     tag  weight\\n\",\n",
    "       \"0      actors              someone other than patient  3.2189\\n\",\n",
    "       \"1      actors  certified emergency medical technician  3.2189\\n\",\n",
    "       \"2      actors                     attending physician  3.2189\\n\",\n",
    "       \"3      actors                     lead epidemiologist  3.2189\\n\",\n",
    "       \"4      actors                orbital health authority  3.2189\\n\",\n",
