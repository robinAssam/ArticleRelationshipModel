    "    \"sem_only    = sem_pairs - exact_pairs\\n\",\n",
    "    \"exact_only  = exact_pairs - sem_pairs\\n\",\n",
    "    \"both        = sem_pairs & exact_pairs\\n\",\n",
    "    \"print(f'Atom pairs connected by exact only:    {len(exact_only)}')\\n\",\n",
    "    \"print(f'Atom pairs connected by semantic only: {len(sem_only)}')\\n\",\n",
    "    \"print(f'Atom pairs connected by both:          {len(both)}')\\n\",\n",
    "    \"\\n\",\n",
    "    \"if sem_only:\\n\",\n",
