    "   \"source\": [\n",
    "    \"### exact edges vs semantic edges\\n\",\n",
    "    \"\\n\",\n",
    "    \"Both channels operate on the same atoms. Exact edges are deterministic and auditable; semantic edges catch synonyms exact-match misses. Use both.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-06-23T13:08:42.305615Z\",\n",
    "     \"start_time\": \"2026-06-23T13:08:42.287361Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# Cross-article exact edges from earlier\\n\",\n",
    "    \"exact = edges.copy()\\n\",\n",
    "    \"exact['edge_kind'] = 'exact'\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Cross-article semantic edges, harmonised to the same columns\\n\",\n",
    "    \"sem = sem_edges.copy()\\n\",\n",
    "    \"sem['edge_kind'] = 'semantic'\\n\",\n",
    "    \"sem['shared'] = sem['matched_pairs']\\n\",\n",
    "    \"sem['strength'] = sem['n_matches']\\n\",\n",
    "    \"sem['weighted_strength'] = sem['max_similarity']\\n\",\n",
    "    \"\\n\",\n",
    "    \"cols = ['edge_kind', 'atom_a', 'atom_b', 'field', 'shared', 'strength', 'weighted_strength']\\n\",\n",
    "    \"combined = pd.concat([exact[cols], sem[cols]], ignore_index=True)\\n\",\n",
    "    \"combined.sort_values(['atom_a', 'atom_b', 'edge_kind'])\\n\"\n",
    "   ],\n",
